# ==============================================================================
# DEIG CRS Environment Configuration
# ==============================================================================

# Port configuration (Auto-detected on Render, defaults to 3000 locally)
PORT=3000
NODE_ENV=development

# MySQL Database URL format:
# mysql://<username>:<password>@<host>:<port>/<database_name>
# Note: If your password contains special characters (like '@' or '#'), URL-encode them (e.g. '@' becomes '%40')
#
# Examples:
# Local MySQL:
DATABASE_URL=mysql://root:iseeyou%407@localhost:3306/crs_db

# Cloud MySQL (Render / Aiven / TiDB Cloud / PlanetScale / Clever Cloud / Railway):
# DATABASE_URL=mysql://user:password@mysql-instance.aivencloud.com:12345/defaultdb?ssl={"rejectUnauthorized":true}

# Enable SSL for cloud MySQL instances:
MYSQL_SSL=true

# Alternative individual MySQL credentials (if not using DATABASE_URL):
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=password
# MYSQL_DATABASE=deig_crs
